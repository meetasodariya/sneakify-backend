# Django Configuration
DJANGO_SECRET_KEY=django-insecure-sneakify-super-secret-key-replace-in-production
DJANGO_ENV=development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# PostgreSQL Database (Neon connection string or SQLite for local dev)
# Example Neon URL: postgresql://username:password@ep-sneakify-1234.ap-southeast-1.aws.neon.tech/sneakify?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Origins (Frontend Next.js URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
